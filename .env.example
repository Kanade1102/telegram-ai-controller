# Telegram Bot Configuration
# Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram User IDs allowed to access the bot (REQUIRED for security)
# Default is DENY ALL if this is empty. Example: TELEGRAM_ALLOWED_USERS=123456789,987654321
TELEGRAM_ALLOWED_USERS=

# Browser CDP (Chrome DevTools Protocol) Configuration
# Default connects to Chrome/Chromium running with --remote-debugging-port=9222 on localhost
BROWSER_CDP_URL=http://127.0.0.1:9222

# Default Settings
# Mode: "browser", "api", or "auto"
DEFAULT_MODE=browser
# Provider: "chatgpt_web", "gemini_web", "claude_web", "deepseek_web", "openai", "gemini_api", "openrouter", "9router", etc.
DEFAULT_PROVIDER=chatgpt_web

# Screenshot Configuration
# Options: "browser" (native page screenshot), "window", "desktop"
SCREENSHOT_MODE=browser
SCREENSHOT_DIR=./screenshots
# Max chars of AI response text sent in a single Telegram message (0 = unlimited)
RESPONSE_CHAR_LIMIT=3900

# Streaming and Cache settings
TELEGRAM_STREAM_UPDATE_INTERVAL=1.5
MODEL_CACHE_SECONDS=1800

# Optional Local Management Web UI (binds ONLY to localhost 127.0.0.1)
LOCAL_SERVER_ENABLED=true
LOCAL_SERVER_HOST=127.0.0.1
LOCAL_SERVER_PORT=8765

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# API PROVIDERS (Leave blank if not using)
# ==============================================================================

# OpenAI API
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

# Google Gemini API
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.6-flash

# OpenRouter API (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct

# 9Router API (OpenAI-compatible)
ROUTER9_ENABLED=true
ROUTER9_API_KEY=
ROUTER9_BASE_URL=https://api.9router.com/v1
ROUTER9_DEFAULT_MODEL=

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
